classDiagram
    class FoodItem {
        +long id
        +String name
        +String normalizedName
        +double quantity
        +String unit
        +long categoryId
        +long storageLocationId
        +long purchaseDate
        +long expirationDate
        +String status
        +String barcode
    }
    class Category {
        +long id
        +String name
    }
    class StorageLocation {
        +long id
        +String name
    }
    class ConsumptionHistory {
        +long id
        +long foodItemId
        +String foodName
        +double quantity
        +String disposition
        +long timestamp
        +fromFoodItem(item, disposition, time)$ ConsumptionHistory
    }
    class ShoppingItem {
        +long id
        +String name
        +String normalizedName
        +double quantity
        +String unit
        +String store
        +boolean checked
        +boolean autoGenerated
    }
    class MealPlan {
        +long id
        +long planDate
        +String mealType
        +String recipeId
        +String recipeTitle
        +boolean completed
    }
    class IngredientLine {
        +int position
        +String text
        +String normalizedName
        +double quantity
        +String unit
        +boolean explicitQuantity
    }
    class MealPlanIngredient
    class FavoriteRecipe {
        +long id
        +String recipeId
        +String title
        +long savedAt
        +nutrition and source details
    }
    class FavoriteRecipeIngredient
    class FavoriteRecipeStep {
        +int position
        +String text
    }
    class ItemStatus {
        <<constants>>
        ACTIVE
        CONSUMED
        WASTED
        EXPIRED
        DONATED
    }
    class MealType {
        <<constants>>
        BREAKFAST
        LUNCH
        DINNER
        SNACK
    }
    class Freshness {
        <<enumeration>>
        FRESH
        USE_SOON
        EXPIRED
        NO_DATE
    }

    FoodItem ..|> Parcelable
    FoodItem --> Category : categoryId
    FoodItem --> StorageLocation : storageLocationId
    ConsumptionHistory ..> FoodItem : foodItemId, no foreign key
    FoodItem ..> ItemStatus : status
    ConsumptionHistory ..> ItemStatus : disposition
    MealPlan ..> MealType
    MealPlan "1" *-- "many" MealPlanIngredient
    FavoriteRecipe "1" *-- "many" FavoriteRecipeIngredient
    FavoriteRecipe "1" *-- "many" FavoriteRecipeStep
    IngredientLine <|-- MealPlanIngredient
    IngredientLine <|-- FavoriteRecipeIngredient
    MealPlan ..> FavoriteRecipe : recipeId, same text id
