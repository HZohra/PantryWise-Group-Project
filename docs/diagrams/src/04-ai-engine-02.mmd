sequenceDiagram
    actor U as User
    participant A as AiAssistantActivity
    participant VM as AiChatViewModel
    participant R as AiRepository
    participant P as PantryRepository
    participant S as AiPreferencesStore
    participant BE as Backend
    participant C as Claude

    U->>A: Send
    A->>VM: needsConsent()
    alt first message
        A->>U: consent dialog
        U-->>A: Continue
        A->>VM: giveConsent()
    end
    A->>VM: sendMessage(text)
    VM->>VM: add the user bubble, loading = true
    VM->>R: sendChatMessage(text, history)
    R->>P: getActiveItemsSync() (background thread)
    P-->>R: items
    R->>R: InventoryMapper: sort by urgency, at most 200, clamp lengths
    R->>S: food profile (allergies, labels, diet, goal)
    R->>BE: POST /ai/chat (message, history, inventory, preferences, locale)
    BE->>BE: validate and rate limit
    BE->>C: system prompt (rules and pantry) and messages
    C-->>BE: reply, and optionally a call of the add_to_shopping_list tool
    BE-->>R: reply and shoppingItems (allergens removed)
    R-->>VM: result (postValue)
    VM-->>A: messages and loading = false
    A-->>U: new bubble, with a confirm card when items are proposed
