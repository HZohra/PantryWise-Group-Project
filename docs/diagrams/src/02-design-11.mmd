sequenceDiagram
    actor U as User
    participant MA as MealPlannerActivity
    participant VM as MealPlannerViewModel
    participant G as ShoppingListGenerator
    participant R as PantryRepository
    participant C as ShoppingCalculator
    participant SA as ShoppingListActivity

    U->>MA: taps Generate shopping list
    MA->>VM: generateForDisplayedWeek()
    VM->>G: generate(weekStart, weekEnd) on the write executor
    G->>R: getMealPlansSync(from, to)
    G->>R: getStockSummarySync()
    G->>R: getShoppingItemsSync()
    G->>C: computeMissing(plans, stock, currentList)
    C-->>G: missing items
    G->>R: replaceAutoGeneratedShoppingItems(missing)
    R-->>G: how many were added
    G-->>VM: Result(meals, added)
    VM-->>MA: generated event (postValue)
    MA-->>U: snackbar with the number of items and the action View list
    U->>SA: opens the shopping list
    Note over SA: the list is a LiveData, so it already shows the new items
