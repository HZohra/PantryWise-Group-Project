flowchart TD
    Main["MainActivity<br/>PantryWise home"]
    Main --> Shop[ShoppingListActivity]
    Main --> Plan[MealPlannerActivity]
    Main --> Waste[WasteSummaryActivity]
    Main --> AddFood["AddFoodActivity<br/>(optionally opens the scanner)"]
    AddFood --> Scan[ScannerActivity]
    Main --> Detail["ItemDetailActivity<br/>(tap a food item)"]
    Main --> Settings[SettingsActivity]
    Main -. "first launch" .-> Profile["FoodProfileActivity<br/>(food profile)"]
    Settings --> Profile
    Main --> AI[AiAssistantActivity]
    AI --> Profile
    Main --> Recipes[RecipesActivity]
    Recipes --> Profile
    Main --> Favs[FavoritesActivity]
    Recipes --> RDetail[RecipeDetailActivity]
    Recipes --> AIRecipe[AiRecipeActivity]
    Favs --> Saved[SavedRecipeActivity]
    Notif(["Expiration notification"]) --> Shop
