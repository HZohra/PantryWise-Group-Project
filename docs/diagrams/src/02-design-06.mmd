erDiagram
    categories ||--o{ food_items : "categoryId"
    storage_locations ||--o{ food_items : "storageLocationId"
    food_items ||--o{ consumption_history : "foodItemId (no FK)"
    meal_plans ||--o{ meal_plan_ingredients : "mealPlanId, cascade"
    favorite_recipes ||--o{ favorite_recipe_ingredients : "favoriteId, cascade"
    favorite_recipes ||--o{ favorite_recipe_steps : "favoriteId, cascade"
    favorite_recipes ||--o{ meal_plans : "recipeId (text, no FK)"

    food_items {
        INTEGER id PK
        TEXT name
        TEXT normalizedName
        REAL quantity
        TEXT unit
        INTEGER categoryId
        INTEGER storageLocationId
        INTEGER purchaseDate
        INTEGER expirationDate
        TEXT status
        TEXT barcode
    }
    categories {
        INTEGER id PK
        TEXT name UK
    }
    storage_locations {
        INTEGER id PK
        TEXT name UK
    }
    consumption_history {
        INTEGER id PK
        INTEGER foodItemId
        TEXT foodName
        TEXT normalizedName
        REAL quantity
        TEXT unit
        INTEGER categoryId
        TEXT disposition
        INTEGER timestamp
    }
    shopping_items {
        INTEGER id PK
        TEXT name
        TEXT normalizedName
        REAL quantity
        TEXT unit
        TEXT store
        INTEGER checked
        INTEGER autoGenerated
        INTEGER createdAt
    }
    meal_plans {
        INTEGER id PK
        INTEGER planDate
        TEXT mealType
        TEXT recipeId
        TEXT recipeTitle
        INTEGER completed
        INTEGER createdAt
    }
    meal_plan_ingredients {
        INTEGER id PK
        INTEGER mealPlanId FK
        INTEGER position
        TEXT text
        TEXT normalizedName
        REAL quantity
        TEXT unit
        INTEGER explicitQuantity
    }
    favorite_recipes {
        INTEGER id PK
        TEXT recipeId UK
        TEXT title
        INTEGER savedAt
        TEXT imageUrl
        TEXT sourceName
        TEXT sourceUrl
        INTEGER servings
        INTEGER totalTimeMinutes
        TEXT tip
        REAL calories
        REAL protein
        REAL carbs
        REAL fat
    }
    favorite_recipe_ingredients {
        INTEGER id PK
        INTEGER favoriteId FK
        INTEGER position
        TEXT text
        TEXT normalizedName
        REAL quantity
        TEXT unit
        INTEGER explicitQuantity
    }
    favorite_recipe_steps {
        INTEGER id PK
        INTEGER favoriteId FK
        INTEGER position
        TEXT text
    }
