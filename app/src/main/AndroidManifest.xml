<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- required from android 13 to show notifications (expiration alerts) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- lets the AI assistant call the PantryWise backend -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- android 11+ hides other apps unless declared: needed so resolveActivity() sees apps that
         can receive the shared shopping list -->
    <queries>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="text/plain" />
        </intent>
        <!-- lets resolveActivity() see a maps app for the "find stores nearby" button -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="geo" />
        </intent>
    </queries>

    <application
        android:name=".PantryWiseApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CP470GroupProject">
        <activity
            android:name=".activities.MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.itemdetail.ItemDetailActivity"
            android:exported="false"
            android:parentActivityName=".ui.inventory.InventoryActivity" />

        <activity
            android:name=".ui.wastesummary.WasteSummaryActivity"
            android:exported="false"
            android:parentActivityName=".ui.inventory.InventoryActivity" />

        <activity
            android:name=".ui.shoppinglist.ShoppingListActivity"
            android:exported="false"
            android:theme="@style/Theme.CP470GroupProject.Shopping"
            android:parentActivityName=".ui.inventory.InventoryActivity" />

        <activity
            android:name=".ui.mealplanner.MealPlannerActivity"
            android:exported="false"
            android:parentActivityName=".ui.inventory.InventoryActivity"
            android:theme="@style/Theme.CP470GroupProject.Shopping" />

        <activity
            android:name=".ui.ai.AiAssistantActivity"
            android:exported="false"
            android:label="@string/ai_chat_title"
            android:parentActivityName=".ui.inventory.InventoryActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ai.RecipesActivity"
            android:exported="false"
            android:label="@string/ai_recipes_title"
            android:parentActivityName=".ui.inventory.InventoryActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.ai.RecipeDetailActivity"
            android:exported="false"
            android:label="@string/ai_detail_title"
            android:parentActivityName=".ui.ai.RecipesActivity" />

        <activity
            android:name=".ui.ai.AiRecipeActivity"
            android:exported="false"
            android:label="@string/ai_gen_title"
            android:parentActivityName=".ui.ai.RecipesActivity" />

        <activity
            android:name=".ui.ai.FavoritesActivity"
            android:exported="false"
            android:label="@string/ai_fav_title"
            android:parentActivityName=".ui.ai.RecipesActivity" />

        <activity
            android:name=".ui.ai.SavedRecipeActivity"
            android:exported="false"
            android:label="@string/ai_gen_title"
            android:parentActivityName=".ui.ai.FavoritesActivity" />

    </application>

</manifest>