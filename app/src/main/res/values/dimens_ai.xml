<?xml version="1.0" encoding="utf-8"?>
<!-- Sizes and limits for the AI assistant screens (Team Member 5). -->
<resources>
    <dimen name="ai_screen_padding">16dp</dimen>
    <dimen name="ai_item_gap">8dp</dimen>
    <dimen name="ai_bubble_padding">12dp</dimen>
    <dimen name="ai_bubble_corner">16dp</dimen>
    <dimen name="ai_bubble_max_width">300dp</dimen>
    <!-- Empty space on the opposite side of a bubble, so user and AI bubbles don't line up -->
    <dimen name="ai_bubble_side_inset">48dp</dimen>

    <!-- Must match the backend's LIMITS.messageMax -->
    <integer name="ai_message_max_length">1000</integer>
</resources>