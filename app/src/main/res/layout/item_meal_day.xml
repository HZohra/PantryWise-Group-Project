<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/PantryWise.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="8dp">

        <TextView
            android:id="@+id/txtDayTitle"
            style="@style/PantryWise.RowTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="4dp" />

        <!-- 2 x 2 grid: breakfast and lunch on the first row, dinner and snack on the second -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2">

            <TextView
                android:id="@+id/slotBreakfast"
                style="@style/PantryWise.Slot"
                android:layout_columnWeight="1" />

            <TextView
                android:id="@+id/slotLunch"
                style="@style/PantryWise.Slot"
                android:layout_columnWeight="1" />

            <TextView
                android:id="@+id/slotDinner"
                style="@style/PantryWise.Slot"
                android:layout_columnWeight="1" />

            <TextView
                android:id="@+id/slotSnack"
                style="@style/PantryWise.Slot"
                android:layout_columnWeight="1" />
        </GridLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
