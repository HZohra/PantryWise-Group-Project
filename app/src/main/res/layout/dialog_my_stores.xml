<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            style="@style/PantryWise.RowSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/shopping_my_stores_help" />

        <!-- one field per StoreType, in the order of the enum: butcher, fish, produce, bakery, general -->
        <EditText
            android:id="@+id/edtMyButcher"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/store_type_butcher"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtMyFish"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/store_type_fish"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtMyProduce"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/store_type_produce"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtMyBakery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/store_type_bakery"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:minHeight="48dp" />

        <EditText
            android:id="@+id/edtMyGeneral"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/store_type_general"
            android:importantForAutofill="no"
            android:inputType="textCapWords"
            android:maxLines="1"
            android:minHeight="48dp" />
    </LinearLayout>
</ScrollView>
