<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/root" xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/main_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:backgroundTint="@color/main_surface"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textColor="@color/main_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_add_food"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="@color/main_text"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/scanBarcodeButton"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/action_scan_barcode" />

        <EditText
            android:id="@+id/foodNameInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_food_name_label"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/foodQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/label_quantity"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/foodUnitInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_unit_hint_add" />

        <Spinner
            android:id="@+id/foodLocationSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/expirationDateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_no_expiration_selected"
            android:layout_marginTop="16dp"
            android:textSize="16sp" />

        <Button
            android:id="@+id/selectExpirationDateButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_select_expiration" />

        <Button
            android:id="@+id/saveFoodButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/form_save_food" />

    </LinearLayout>
</ScrollView>