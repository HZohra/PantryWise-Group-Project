<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="@dimen/ai_item_gap">

    <TextView
        android:id="@+id/ai_ingredient_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        tools:text="3 large eggs" />

    <!-- Status in words (not only colour) + "Find substitute" for missing items -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/ai_ingredient_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="?attr/colorError"
            android:visibility="gone"
            tools:text="@string/ai_detail_missing"
            tools:visibility="visible" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/ai_ingredient_substitute"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/ai_detail_find_substitute"
            android:visibility="gone"
            tools:visibility="visible" />
    </LinearLayout>
</LinearLayout>