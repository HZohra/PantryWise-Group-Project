<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    android:id="@+id/root" xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <Button
            android:id="@+id/backButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start"
            android:backgroundTint="@color/main_surface"
            android:gravity="center"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:padding="0dp"
            android:text="←"
            android:textColor="@color/main_text"
            android:textSize="28sp"
            android:textStyle="bold"
            android:contentDescription="@string/content_description_back" />

        <TextView
            android:id="@+id/txtItemName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp"
            android:textSize="26sp"
            android:textStyle="bold"
            tools:text="Item name" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_food_name_label" />

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_food_name_hint"
            android:inputType="textCapSentences" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_quantity" />

        <EditText
            android:id="@+id/edtQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_quantity"
            android:inputType="numberDecimal" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_unit_label" />

        <EditText
            android:id="@+id/edtUnit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/form_unit_hint_detail"
            android:inputType="text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_storage_location_label" />

        <Spinner
            android:id="@+id/spinnerLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/txtExpirationDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:text="@string/form_no_expiration_selected" />

        <Button
            android:id="@+id/btnSelectExpirationDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_change_expiration" />

        <Button
            android:id="@+id/btnUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/form_save_changes" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="24dp"
            android:paddingBottom="8dp"
            android:text="@string/label_record_disposition"
            android:textSize="18sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnConsumed"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_consumed" />

        <Button
            android:id="@+id/btnWasted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_wasted" />

        <Button
            android:id="@+id/btnExpired"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_expired" />

        <Button
            android:id="@+id/btnDonated"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_donated" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/action_delete_item" />

    </LinearLayout>
</ScrollView>