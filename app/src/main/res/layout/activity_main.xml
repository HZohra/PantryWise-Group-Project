<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="@color/main_background"
    tools:context=".activities.MainActivity">

    <!-- Header -->
    <TextView
        android:id="@+id/inventoryTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PantryWise"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="@color/main_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/welcomeSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your kitchen, organized."
        android:textSize="13sp"
        android:textColor="#68786D"
        app:layout_constraintTop_toBottomOf="@id/inventoryTitle"
        app:layout_constraintStart_toStartOf="parent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/helpButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="?"
        android:textSize="20sp"
        android:textColor="#244B37"
        android:contentDescription="Help"
        app:backgroundTint="#E5EDE6"
        app:cornerRadius="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toStartOf="@id/settingsButton"
        android:layout_marginEnd="8dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:padding="0dp"
        android:text="⚙"
        android:textSize="20sp"
        android:textColor="#244B37"
        android:contentDescription="Settings"
        app:backgroundTint="#E5EDE6"
        app:cornerRadius="22dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Search -->
    <EditText
        android:id="@+id/searchFood"
        android:layout_width="0dp"
        android:layout_height="50dp"
        android:hint="Search your food..."
        android:inputType="text"
        android:singleLine="true"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="10dp"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="#263B2E"
        android:textColorHint="#849187"
        android:backgroundTint="#DCE5DC"
        app:layout_constraintTop_toBottomOf="@id/welcomeSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Main features heading -->
    <TextView
        android:id="@+id/quickAccessTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUICK ACCESS"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#68786D"
        app:layout_constraintTop_toBottomOf="@id/searchFood"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="16dp" />

    <!-- Main feature buttons -->
    <LinearLayout
        android:id="@+id/projectNavigationButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="6dp"
        app:layout_constraintTop_toBottomOf="@id/quickAccessTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/shoppingListButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Shopping List"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#315D43"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/mealPlannerButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Meal Planner"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#FFFFFF"
                app:backgroundTint="#315D43"
                app:cornerRadius="12dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/wasteSummaryButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginEnd="5dp"
                android:text="Waste Summary"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/main_text"
                app:backgroundTint="#E1EBDD"
                app:cornerRadius="12dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/scannerButton"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:layout_marginStart="5dp"
                android:text="Scan Barcode"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="#244B37"
                app:backgroundTint="#E1EBDD"
                app:cornerRadius="12dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- AI features -->
    <TextView
        android:id="@+id/aiFeaturesTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="DISCOVER"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#68786D"
        app:layout_constraintTop_toBottomOf="@id/projectNavigationButtons"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="10dp" />

    <LinearLayout
        android:id="@+id/navigationButtons"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="3"
        android:layout_marginTop="2dp"
        app:layout_constraintTop_toBottomOf="@id/aiFeaturesTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/aiAssistantButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="3dp"
            android:minWidth="0dp"
            android:text="AI Assistant"
            android:textSize="10sp"
            android:textAllCaps="false"
            android:textColor="#315D43"
            app:backgroundTint="#E5EDE6"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/recipesButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:minWidth="0dp"
            android:text="Recipes"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#315D43"
            app:backgroundTint="#E5EDE6"
            app:cornerRadius="10dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/favoritesButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginStart="3dp"
            android:minWidth="0dp"
            android:text="Favorites"
            android:textSize="11sp"
            android:textAllCaps="false"
            android:textColor="#315D43"
            app:backgroundTint="#E5EDE6"
            app:cornerRadius="10dp" />
    </LinearLayout>

    <!-- Storage locations -->
    <TextView
        android:id="@+id/storageTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MY STORAGE"
        android:textSize="12sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:textColor="#68786D"
        app:layout_constraintTop_toBottomOf="@id/navigationButtons"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginTop="12dp" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/locationToggleGroup"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        app:singleSelection="true"
        app:selectionRequired="true"
        app:checkedButton="@id/fridgeButton"
        app:layout_constraintTop_toBottomOf="@id/storageTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/fridgeButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Fridge"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/freezerButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Freezer"
            android:textAllCaps="false"
            android:textSize="12sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pantryButton"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="Pantry"
            android:textAllCaps="false"
            android:textSize="12sp" />
    </com.google.android.material.button.MaterialButtonToggleGroup>

    <!-- Empty inventory message -->
    <TextView
        android:id="@+id/emptyInventory"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="@string/inventory_empty"
        android:textSize="16sp"
        android:textColor="#68786D"
        android:gravity="center"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/locationToggleGroup"
        app:layout_constraintBottom_toTopOf="@id/addFoodButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Inventory list -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/foodRecyclerView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toBottomOf="@id/locationToggleGroup"
        app:layout_constraintBottom_toTopOf="@id/addFoodButton"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:listitem="@layout/item_food" />

    <!-- Add food -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/addFoodButton"
        android:layout_width="0dp"
        android:layout_height="54dp"
        android:text="Add Food"
        android:textAllCaps="false"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="#FFFFFF"
        app:backgroundTint="#244B37"
        app:cornerRadius="14dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>