<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/ai_screen_padding">

    <TextView
        android:id="@+id/ai_sub_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:accessibilityHeading="true"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        tools:text="Instead of egg" />

    <TextView
        android:id="@+id/ai_sub_source"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="?attr/textAppearanceLabelMedium"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="@string/ai_sub_source_local"
        tools:visibility="visible" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/ai_sub_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_item_gap"
        android:contentDescription="@string/ai_sub_loading"
        android:indeterminate="true" />

    <!-- Rows are added from code (item_substitute) -->
    <LinearLayout
        android:id="@+id/ai_sub_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />

    <!-- "No safe substitute found" or an error message -->
    <TextView
        android:id="@+id/ai_sub_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_item_gap"
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:visibility="gone" />

    <TextView
        android:id="@+id/ai_sub_tip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ai_item_gap"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone" />
</LinearLayout>