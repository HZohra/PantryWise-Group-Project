# Copy this file to .env and fill in the values. Never commit .env.

# Required
PORT=3000
ANTHROPIC_MODEL=claude-haiku-5-5
ANTHROPIC_API_KEY=your-anthropic-api-key
EDAMAM_APP_ID=your-edamam-app-id
EDAMAM_APP_KEY=your-edamam-app-key

# Optional: barcode lookup of the scanner (USDA FoodData Central). Free key: https://fdc.nal.usda.gov/api-key-signup
# Without it the scanner reports that the lookup is not configured. DEMO_KEY works but is rate limited.
USDA_API_KEY=your-usda-api-key
