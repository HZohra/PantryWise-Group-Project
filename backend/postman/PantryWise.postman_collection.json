            "pm.test('explains the calorie range', () => pm.expect(body.error.details).to.include('maxCalories must be a whole number from 50 to 3000'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/recipes/search?q=soup&maxCalories=10" }
        },
        {
          "name": "Recommend - expiring first (standard)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const scores = body.recipes.map(r => r.match.score);",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('mode is standard', () => pm.expect(body.mode).to.eql('standard'));",
            "pm.test('searched the two most urgent items', () => pm.expect(body.searchedFor).to.eql(['chicken breast', 'spinach']));",
            "pm.test('sorted best first', () => pm.expect(scores).to.eql([...scores].sort((a, b) => b - a)));",
            "pm.test('every recipe has a match explanation', () => body.recipes.forEach(r => pm.expect(r.match).to.have.keys('score', 'haveCount', 'totalCount', 'have', 'missing', 'expiringUsed')));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"inventory\": [\n    { \"name\": \"milk\", \"quantity\": 1, \"unit\": \"L\", \"daysUntilExpiry\": 2 },\n    { \"name\": \"eggs\", \"quantity\": 6, \"unit\": \"pcs\", \"daysUntilExpiry\": 10 },\n    { \"name\": \"spinach\", \"quantity\": 1, \"unit\": \"bag\", \"daysUntilExpiry\": 1 },\n    { \"name\": \"chicken breast\", \"quantity\": 2, \"unit\": \"pcs\", \"daysUntilExpiry\": 0 },\n    { \"name\": \"rice\", \"quantity\": 1, \"unit\": \"kg\" },\n    { \"name\": \"yogurt\", \"quantity\": 1, \"unit\": \"cup\", \"daysUntilExpiry\": -1 }\n  ],\n  \"limit\": 5\n}" },
            "url": "{{baseUrl}}/recipes/recommend"
          }
        },
        {
          "name": "Recommend - Zero-Waste Mode",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const scores = body.recipes.map(r => r.match.score);",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('mode is zeroWaste', () => pm.expect(body.mode).to.eql('zeroWaste'));",
            "pm.test('every recipe rescues at least one expiring item', () => body.recipes.forEach(r => pm.expect(r.match.expiringUsed).to.not.be.empty));",
            "pm.test('sorted best first', () => pm.expect(scores).to.eql([...scores].sort((a, b) => b - a)));"
          ] } }],
