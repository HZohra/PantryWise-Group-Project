              "raw": "{\n  \"mode\": \"zeroWaste\",\n  \"inventory\": [\n    { \"name\": \"milk\", \"quantity\": 1, \"unit\": \"L\", \"daysUntilExpiry\": 2 },\n    { \"name\": \"eggs\", \"quantity\": 6, \"unit\": \"pcs\", \"daysUntilExpiry\": 10 },\n    { \"name\": \"spinach\", \"quantity\": 1, \"unit\": \"bag\", \"daysUntilExpiry\": 1 },\n    { \"name\": \"chicken breast\", \"quantity\": 2, \"unit\": \"pcs\", \"daysUntilExpiry\": 0 },\n    { \"name\": \"rice\", \"quantity\": 1, \"unit\": \"kg\" },\n    { \"name\": \"yogurt\", \"quantity\": 1, \"unit\": \"cup\", \"daysUntilExpiry\": -1 }\n  ],\n  \"limit\": 5\n}" },
            "url": "{{baseUrl}}/recipes/recommend"
          }
        },
        {
          "name": "Recommend - max 500 kcal per serving",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const recipes = body.recipes || [];",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('finds at least one recipe', () => pm.expect(recipes.length).to.be.above(0));",
