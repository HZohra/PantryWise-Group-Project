            "pm.test('at most 3 recipes', () => pm.expect(body.recipes.length).to.be.at.most(3));",
            "pm.test('count matches list', () => pm.expect(body.count).to.eql(body.recipes.length));",
            "pm.test('ids use the edamam: prefix', () => body.recipes.forEach(r => pm.expect(r.recipeId).to.match(/^edamam:.+/)));",
            "pm.test('each recipe has ingredient lines', () => body.recipes.forEach(r => pm.expect(r.ingredientLines).to.be.an('array')));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/recipes/search?q=chicken&diet=balanced&maxTime=30&limit=3" }
        },
        {
          "name": "Search - missing q (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('says q is required', () => pm.expect(body.error.details).to.include('q is required'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/recipes/search?diet=balanced" }
        },
        {
          "name": "Search - bad filter values (400)",
