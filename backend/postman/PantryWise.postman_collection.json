            "pm.test('lists all 3 problems', () => pm.expect(body.error.details).to.have.lengthOf(3));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/recipes/search?q=soup&diet=keto&maxTime=abc&limit=50" }
        },
        {
          "name": "Search - maxCalories too low (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
