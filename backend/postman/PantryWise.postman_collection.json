{
  "info": {
    "name": "PantryWise AI API",
    "description": "AI Kitchen Assistant & Recipe Engine (Team Member 5).\n\nBefore running: start the backend with `npm run dev` inside `backend/`.\nRun the whole collection at most once per minute (rate limits: 10 AI calls/min, 20 recipe calls/min).\nEach full run makes about 4 Claude calls (2 chat + 2 AI recipes; common substitutions come from the local list) and at most 5 Edamam calls (fewer when the 10-minute cache has the answer).\nThe AI rate limiter sees exactly 10 requests per run, so wait a full minute after any manual AI call before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api/v1" }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Runs after EVERY request in the collection",
          "pm.test('responds with JSON', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
          "// A full AI recipe (with one possible retry) can take longer than a chat reply",
          "const isAiRecipe = pm.request.url.toString().includes('/ai/recipe');",
          "const limitMs = isAiRecipe ? 90000 : 30000;",
          "pm.test(`responds in under ${limitMs / 1000} s`, () => pm.expect(pm.response.responseTime).to.be.below(limitMs));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('status is ok', () => pm.expect(body.status).to.eql('ok'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        },
        {
          "name": "Unknown route returns JSON 404",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('404', () => pm.response.to.have.status(404));",
            "pm.test('code NOT_FOUND', () => pm.expect(body.error.code).to.eql('NOT_FOUND'));"
          ] } }],
          "request": { "method": "GET", "url": "{{baseUrl}}/nope" }
        }
      ]
    },
    {
      "name": "AI Chat",
      "item": [
        {
          "name": "Chat - expiring milk",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('reply is a non-empty string', () => pm.expect(body.reply).to.be.a('string').and.not.be.empty);",
            "pm.test('reply mentions the expiring milk', () => pm.expect(body.reply.toLowerCase()).to.include('milk'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"message\": \"What can I cook with my expiring milk?\",\n  \"inventory\": [\n    { \"name\": \"milk\", \"quantity\": 1, \"unit\": \"L\", \"daysUntilExpiry\": 2 },\n    { \"name\": \"eggs\", \"quantity\": 6, \"unit\": \"pcs\", \"daysUntilExpiry\": 10 },\n    { \"name\": \"rice\" }\n  ]\n}" },
            "url": "{{baseUrl}}/ai/chat"
          }
        },
        {
          "name": "Chat - remembers diet and allergy",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('suggests the vegetarian option (tofu)', () => pm.expect(body.reply.toLowerCase()).to.include('tofu'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"history\": [\n    { \"role\": \"user\", \"content\": \"Just so you know, I'm vegetarian and allergic to peanuts.\" },\n    { \"role\": \"assistant\", \"content\": \"Got it! I'll keep all suggestions vegetarian and peanut-free.\" }\n  ],\n  \"message\": \"Suggest a quick dinner for tonight.\",\n  \"inventory\": [\n    { \"name\": \"chicken breast\", \"quantity\": 2, \"unit\": \"pcs\", \"daysUntilExpiry\": 1 },\n    { \"name\": \"tofu\", \"quantity\": 1, \"unit\": \"block\", \"daysUntilExpiry\": 2 },\n    { \"name\": \"peanut butter\", \"quantity\": 1, \"unit\": \"jar\", \"daysUntilExpiry\": 90 },\n    { \"name\": \"broccoli\", \"quantity\": 1, \"unit\": \"head\", \"daysUntilExpiry\": 3 }\n  ]\n}" },
            "url": "{{baseUrl}}/ai/chat"
          }
        },
        {
          "name": "Chat - invalid body (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('code VALIDATION_ERROR', () => pm.expect(body.error.code).to.eql('VALIDATION_ERROR'));",
            "pm.test('lists all 3 problems', () => pm.expect(body.error.details).to.have.lengthOf(3));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"message\": \"\",\n  \"history\": [{ \"role\": \"robot\", \"content\": \"hi\" }],\n  \"inventory\": [{ \"name\": \"milk\", \"quantity\": -3 }]\n}" },
            "url": "{{baseUrl}}/ai/chat"
          }
        }
      ]
    },
    {
      "name": "AI Recipe",
      "item": [
        {
          "name": "AI recipe - uses expiring food",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const recipe = body.recipe || {};",
            "const ingredients = recipe.ingredients || [];",
            "const steps = recipe.steps || [];",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('recipeId uses the ai: prefix', () => pm.expect(recipe.recipeId).to.match(/^ai:[0-9a-f-]{36}$/));",
            "pm.test('keeps the requested 2 servings', () => pm.expect(recipe.servings).to.eql(2));",
            "pm.test('expiring items are spinach then feta (expired milk ignored)', () => {",
            "  pm.expect(body.usedExpiring).to.be.true;",
            "  pm.expect(body.expiringItems).to.eql(['spinach', 'feta']);",
            "});",
            "pm.test('recipe uses at least one expiring item', () => pm.expect(ingredients.some(i => i.expiring)).to.be.true);",
            "pm.test('2 to 25 ingredients, each with name, amount and flags', () => {",
            "  pm.expect(ingredients.length).to.be.within(2, 25);",
            "  ingredients.forEach(i => pm.expect(i).to.have.keys('name', 'amount', 'inPantry', 'expiring', 'staple'));",
            "});",
            "pm.test('2 to 15 steps, without step numbers', () => {",
            "  pm.expect(steps.length).to.be.within(2, 15);",
            "  steps.forEach(s => pm.expect(s).to.not.match(/^\\s*\\d+\\s*[.)-]/));",
            "});",
            "pm.test('one ingredient line per ingredient', () => pm.expect(recipe.ingredientLines).to.have.lengthOf(ingredients.length));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"locale\": \"en\",\n  \"servings\": 2,\n  \"inventory\": [\n    { \"name\": \"spinach\", \"quantity\": 1, \"unit\": \"bag\", \"daysUntilExpiry\": 1 },\n    { \"name\": \"feta\", \"quantity\": 200, \"unit\": \"g\", \"daysUntilExpiry\": 2 },\n    { \"name\": \"eggs\", \"quantity\": 6, \"unit\": \"pcs\", \"daysUntilExpiry\": 10 },\n    { \"name\": \"milk\", \"quantity\": 1, \"unit\": \"L\", \"daysUntilExpiry\": -1 },\n    { \"name\": \"rice\", \"quantity\": 1, \"unit\": \"kg\" }\n  ]\n}" },
            "url": "{{baseUrl}}/ai/recipe"
          }
        },
        {
          "name": "AI recipe - Spanish, peanut allergy",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "const recipe = body.recipe || {};",
            "const ingredients = recipe.ingredients || [];",
            "pm.test('200 OK', () => pm.response.to.have.status(200));",
            "pm.test('no peanut ingredient (allergy)', () => ingredients.forEach(i => pm.expect(i.name).to.not.include('peanut')));",
            "pm.test('ingredient names stay English, so they match the pantry', () => pm.expect(ingredients.some(i => i.inPantry)).to.be.true);",
            "pm.test('steps are written in Spanish', () => pm.expect((recipe.steps || []).join(' ').toLowerCase()).to.match(/\\b(el|la|los|las|con|una|un|y)\\b/));",
            "pm.test('flags that expiring food was used', () => pm.expect(body.usedExpiring).to.be.true);"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"locale\": \"es\",\n  \"inventory\": [\n    { \"name\": \"peanut butter\", \"quantity\": 1, \"unit\": \"jar\", \"daysUntilExpiry\": 1 },\n    { \"name\": \"banana\", \"quantity\": 3, \"unit\": \"pcs\", \"daysUntilExpiry\": 1 },\n    { \"name\": \"greek yogurt\", \"quantity\": 2, \"unit\": \"cups\", \"daysUntilExpiry\": 2 },\n    { \"name\": \"oats\", \"quantity\": 500, \"unit\": \"g\" }\n  ],\n  \"preferences\": { \"allergies\": [\"peanut\"] }\n}" },
            "url": "{{baseUrl}}/ai/recipe"
          }
        },
        {
          "name": "AI recipe - only expired food (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('code VALIDATION_ERROR', () => pm.expect(body.error.code).to.eql('VALIDATION_ERROR'));",
            "pm.test('says it needs an item that is not expired', () => pm.expect(body.error.details).to.include('inventory needs at least one item that is not expired'));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{ \"inventory\": [ { \"name\": \"milk\", \"quantity\": 1, \"unit\": \"L\", \"daysUntilExpiry\": -2 } ] }" },
            "url": "{{baseUrl}}/ai/recipe"
          }
        },
        {
          "name": "AI recipe - invalid body (400)",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
            "pm.test('400', () => pm.response.to.have.status(400));",
            "pm.test('lists all 3 problems', () => pm.expect(body.error.details).to.have.lengthOf(3));"
          ] } }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "options": { "raw": { "language": "json" } },
              "raw": "{\n  \"servings\": 20,\n  \"locale\": 5,\n  \"inventory\": [{ \"name\": \"\" }]\n}" },
            "url": "{{baseUrl}}/ai/recipe"
          }
        }
      ]
    },
    {
      "name": "Recipes",
      "item": [
        {
          "name": "Search - chicken, balanced, 30 min",
          "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": [
            "const body = pm.response.json();",
